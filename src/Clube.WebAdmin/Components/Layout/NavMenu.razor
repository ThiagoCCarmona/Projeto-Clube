@inject WebAdminSession Session

<div class="top-row ps-3 navbar navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-white d-flex align-items-center gap-2" href="">
            <i class="bi bi-diagram-3-fill text-warning"></i> Projeto Clubes
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2 me-2"></i> Início / Painel
            </NavLink>
        </div>

        @if (Session.Perfil == PerfilUsuario.SuperAdmin)
        {
            <div class="text-uppercase text-secondary small px-3 mt-3 mb-1 fw-bold">Super Admin</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="superadmin/clubes">
                    <i class="bi bi-buildings me-2"></i> Federação & Clubes
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="superadmin/novo-clube">
                    <i class="bi bi-plus-circle me-2"></i> Cadastrar Clube
                </NavLink>
            </div>
        }

        @if (Session.Perfil == PerfilUsuario.Presidente || Session.Perfil == PerfilUsuario.SuperAdmin)
        {
            <div class="text-uppercase text-secondary small px-3 mt-3 mb-1 fw-bold">Gestão do Clube</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="presidente/associados">
                    <i class="bi bi-person-check me-2"></i> Aprovação de Sócios
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="presidente/reservas">
                    <i class="bi bi-calendar-event me-2"></i> Salão Social & Reservas
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="presidente/eventos">
                    <i class="bi bi-megaphone me-2"></i> Eventos & Comunicados
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="presidente/solicitacoes">
                    <i class="bi bi-chat-left-dots me-2"></i> Atendimento / SAC
                </NavLink>
            </div>
        }

        @if (Session.Perfil == PerfilUsuario.Tesoureiro || Session.Perfil == PerfilUsuario.SuperAdmin)
        {
            <div class="text-uppercase text-secondary small px-3 mt-3 mb-1 fw-bold">Tesouraria Web</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="tesoureiro/mensalidades">
                    <i class="bi bi-cash-coin me-2"></i> Mensalidades & PIX
                </NavLink>
            </div>
        }
    </nav>
</div>
