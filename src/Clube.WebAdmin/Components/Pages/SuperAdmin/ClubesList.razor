@page "/superadmin/clubes"
@rendermode InteractiveServer
@inject IClubeService ClubeService

<PageTitle>Federação de Clubes - Super Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-buildings text-primary me-2"></i> Federação & Clubes</h2>
        <p class="text-muted mb-0">Gerencie todos os clubes cadastrados na plataforma (Foz do Iguaçu, Guaíra e demais regiões).</p>
    </div>
    <a href="superadmin/novo-clube" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Cadastrar Novo Clube
    </a>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nome do Clube</th>
                        <th>Sigla</th>
                        <th>Localização</th>
                        <th>Contato</th>
                        <th>Chave PIX</th>
                        <th>Mensalidade Padrão</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Clubes != null && Clubes.Count > 0)
                    {
                        @foreach (var c in Clubes)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold fs-6">@c.Nome</div>
                                    <small class="text-muted">@c.AssociadosPendentes solicitação(ões) pendente(s)</small>
                                </td>
                                <td><span class="badge bg-secondary">@c.Sigla</span></td>
                                <td>
                                    <div>@c.Endereco, @c.Bairro</div>
                                    <small class="text-muted">@c.Cidade - @c.UF</small>
                                </td>
                                <td>
                                    <div><i class="bi bi-telephone text-muted me-1"></i> @c.Telefone</div>
                                    <small class="text-muted"><i class="bi bi-envelope text-muted me-1"></i> @c.Email</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-qr-code me-1 text-primary"></i> @c.ChavePix (@c.TipoChavePix)
                                    </span>
                                </td>
                                <td><span class="fw-bold text-success">@c.ValorMensalidadePadrao.ToString("C")</span></td>
                                <td>
                                    @if (c.Ativo)
                                    {
                                        <span class="badge bg-success">Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inativo</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => AlternarStatus(c)">
                                        @(c.Ativo ? "Desativar" : "Ativar")
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Nenhum clube encontrado.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<ClubeDto>? Clubes;

    protected override async Task OnInitializedAsync()
    {
        await CarregarClubesAsync();
    }

    private async Task CarregarClubesAsync()
    {
        Clubes = await ClubeService.ListarTodosAsync();
    }

    private async Task AlternarStatus(ClubeDto c)
    {
        c.Ativo = !c.Ativo;
        await ClubeService.AtualizarClubeAsync(c.Id, c);
        await CarregarClubesAsync();
    }
}
