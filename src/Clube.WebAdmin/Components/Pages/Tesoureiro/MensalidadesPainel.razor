@page "/tesoureiro/mensalidades"
@rendermode InteractiveServer
@inject IMensalidadeService MensalidadeService
@inject WebAdminSession Session
@inject IJSRuntime JSRuntime

<PageTitle>Tesouraria - Gestão de Mensalidades</PageTitle>

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 border-bottom pb-3">
        <div>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 mb-1">
                <i class="bi bi-cash-coin me-1"></i> Módulo Financeiro
            </span>
            <h2 class="h3 fw-bold mb-0">Controle de Mensalidades & Arrecadação</h2>
            <p class="text-muted small mb-0">
                Gestão da situação financeira, conciliação de pagamentos e emissão de cobranças via PIX.
            </p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="CarregarDadosAsync">
                <i class="bi bi-arrow-clockwise me-1"></i> Atualizar
            </button>
            <button class="btn btn-success" @onclick="AbrirModalLote">
                <i class="bi bi-plus-circle me-1"></i> Gerar Novo Lote
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagemAlerta))
    {
        <div class="alert @(isSucesso ? "alert-success" : "alert-danger") alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="bi @(isSucesso ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") fs-5 me-2"></i>
            <div>@mensagemAlerta</div>
            <button type="button" class="btn-close" @onclick="() => mensagemAlerta = null"></button>
        </div>
    }

    <!-- KPIs Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-semibold">Arrecadado</span>
                        <div class="p-2 bg-success-subtle text-success rounded-circle">
                            <i class="bi bi-check2-circle fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-0 text-success">@resumo.TotalArrecadado.ToString("C")</h3>
                    <div class="small text-muted mt-1">@resumo.QuantidadePaga mensalidade(s) liquidada(s)</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-semibold">A Vencer / Pendente</span>
                        <div class="p-2 bg-warning-subtle text-warning rounded-circle">
                            <i class="bi bi-clock-history fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-0 text-warning">@resumo.TotalPendente.ToString("C")</h3>
                    <div class="small text-muted mt-1">@resumo.QuantidadePendente em aberto</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-semibold">Em Atraso</span>
                        <div class="p-2 bg-danger-subtle text-danger rounded-circle">
                            <i class="bi bi-exclamation-octagon fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-0 text-danger">@resumo.TotalAtrasado.ToString("C")</h3>
                    <div class="small text-muted mt-1">@resumo.QuantidadeAtrasada mensalidade(s) vencida(s)</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-semibold">Taxa de Adimplência</span>
                        <div class="p-2 bg-primary-subtle text-primary rounded-circle">
                            <i class="bi bi-pie-chart fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-0 text-primary">@resumo.TaxaAdimplenciaPercentual%</h3>
                    <div class="small text-muted mt-1">Índice global de conformidade</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros de Busca -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Buscar associado ou CPF..." @bind="termoBusca" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select class="form-select" @bind="filtroStatus">
                        <option value="">Todos os status</option>
                        <option value="Pendente">Pendente</option>
                        <option value="Paga">Paga</option>
                        <option value="Atrasada">Atrasada</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <input type="text" class="form-control" placeholder="Competência (ex: 11/2026)" @bind="filtroCompetencia" />
                </div>
                <div class="col-12 col-md-2 text-end">
                    <button class="btn btn-outline-secondary w-100" @onclick="CarregarDadosAsync">
                        <i class="bi bi-funnel me-1"></i> Filtrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela de Mensalidades -->
    @if (carregando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Carregando dados da tesouraria...</p>
        </div>
    }
    else if (!MensalidadesFiltradas.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5 rounded-3">
            <div class="card-body">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <h5 class="fw-bold mt-3">Nenhuma mensalidade encontrada</h5>
                <p class="text-muted">Gere um novo lote para a competência atual para faturar os sócios.</p>
                <button class="btn btn-success" @onclick="AbrirModalLote">
                    <i class="bi bi-plus-circle me-1"></i> Gerar Primeiro Lote
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Associado</th>
                            <th>Competência</th>
                            <th>Vencimento</th>
                            <th>Valor</th>
                            <th>Status</th>
                            <th>Pagamento / Baixa</th>
                            <th class="text-end pe-3">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in MensalidadesFiltradas)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold">@m.NomeAssociado</div>
                                    <div class="text-muted small">CPF: @m.CpfAssociado</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-calendar3 me-1"></i> @m.Competencia
                                    </span>
                                </td>
                                <td>
                                    <span class="@(m.Status == StatusMensalidade.Atrasada ? "text-danger fw-bold" : "")">
                                        @m.DataVencimento.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td class="fw-semibold">
                                    @m.Valor.ToString("C")
                                </td>
                                <td>
                                    @switch (m.Status)
                                    {
                                        case StatusMensalidade.Paga:
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Paga</span>
                                            break;
                                        case StatusMensalidade.Pendente:
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Pendente</span>
                                            break;
                                        case StatusMensalidade.Atrasada:
                                            <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i> Atrasada</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (m.DataPagamento.HasValue)
                                    {
                                        <div class="small text-success">
                                            <i class="bi bi-calendar-check me-1"></i> @m.DataPagamento.Value.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                        @if (!string.IsNullOrEmpty(m.ComprovantePagamento))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 180px;">
                                                Ref: @m.ComprovantePagamento
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Não registrado</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-info" title="Ver Chave PIX" @onclick="() => AbrirModalPix(m)">
                                            <i class="bi bi-qr-code"></i> PIX
                                        </button>
                                        @if (m.Status != StatusMensalidade.Paga)
                                        {
                                            <button class="btn btn-outline-success" title="Registrar Pagamento Manual" @onclick="() => AbrirModalBaixa(m)">
                                                <i class="bi bi-check2"></i> Baixa
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal Gerar Lote -->
@if (exibirModalLote)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-plus-circle me-2"></i> Gerar Lote de Mensalidades
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalLote = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Este processo irá faturar automaticamente todos os <strong>Sócios Fundadores</strong> e <strong>Sócios Convidados</strong>
                        aprovados no clube, gerando cobranças com código PIX instantâneo.
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Competência (Mês/Ano)*</label>
                        <input type="text" class="form-control" placeholder="ex: 11/2026" @bind="loteRequest.Competencia" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Data de Vencimento*</label>
                        <input type="date" class="form-control" @bind="loteRequest.DataVencimento" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Valor Customizado (opcional)</label>
                        <div class="input-group">
                            <span class="input-group-text">R$</span>
                            <input type="number" step="0.01" class="form-control" placeholder="Deixe em branco para usar o padrão do clube" @bind="loteRequest.ValorCustomizado" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => exibirModalLote = false">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="ConfirmarGeracaoLoteAsync">
                        <i class="bi bi-gear-fill me-1"></i> Faturar Sócios
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Detalhe PIX -->
@if (exibirModalPix && mensalidadeSelecionada != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-qr-code me-2"></i> Cobrança PIX
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalPix = false"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="mb-1 fw-bold fs-5">@mensalidadeSelecionada.NomeAssociado</p>
                    <p class="text-muted small mb-3">Competência @mensalidadeSelecionada.Competencia - Valor: <strong>@mensalidadeSelecionada.Valor.ToString("C")</strong></p>
                    
                    <div class="p-3 bg-light rounded-3 text-start border mb-3">
                        <label class="form-label small text-muted fw-semibold">Código PIX Copia-e-Cola (EMV):</label>
                        <textarea class="form-control font-monospace small" rows="4" readonly>@mensalidadeSelecionada.CodigoPixCopiaECola</textarea>
                    </div>

                    <p class="small text-muted mb-0">
                        <i class="bi bi-info-circle me-1"></i> Este código segue o padrão oficial BACEN (EMV com CRC16). O associado pode colar em qualquer aplicativo bancário para quitação instantânea.
                    </p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => exibirModalPix = false">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Baixa Manual -->
@if (exibirModalBaixa && mensalidadeSelecionada != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-check2-circle me-2"></i> Baixa Manual de Mensalidade
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalBaixa = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-2"><strong>Associado:</strong> @mensalidadeSelecionada.NomeAssociado</p>
                    <p class="mb-2"><strong>Competência:</strong> @mensalidadeSelecionada.Competencia</p>
                    <p class="mb-3"><strong>Valor:</strong> @mensalidadeSelecionada.Valor.ToString("C")</p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Data do Pagamento*</label>
                        <input type="datetime-local" class="form-control" @bind="baixaRequest.DataPagamento" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Comprovante / Autenticação Bancária</label>
                        <input type="text" class="form-control" placeholder="ex: TED / PIX TXID E1234567..." @bind="baixaRequest.Comprovante" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => exibirModalBaixa = false">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="ConfirmarBaixaAsync">
                        <i class="bi bi-check-lg me-1"></i> Confirmar Liquidação
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MensalidadeDto> mensalidades = new();
    private ResumoFinanceiroDto resumo = new();
    private bool carregando = true;
    private string? mensagemAlerta;
    private bool isSucesso = true;

    // Filtros
    private string termoBusca = "";
    private string filtroStatus = "";
    private string filtroCompetencia = "";

    // Modais
    private bool exibirModalLote = false;
    private GerarLoteMensalidadesRequest loteRequest = new()
    {
        Competencia = $"{DateTime.Today.Month:D2}/{DateTime.Today.Year}",
        DataVencimento = DateTime.Today.AddDays(10)
    };

    private bool exibirModalPix = false;
    private bool exibirModalBaixa = false;
    private MensalidadeDto? mensalidadeSelecionada;
    private BaixarMensalidadeRequest baixaRequest = new()
    {
        DataPagamento = DateTime.Now
    };

    private IEnumerable<MensalidadeDto> MensalidadesFiltradas
    {
        get
        {
            var res = mensalidades.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(termoBusca))
            {
                var t = termoBusca.Trim().ToLower();
                res = res.Where(m => m.NomeAssociado.ToLower().Contains(t) || m.CpfAssociado.Contains(t));
            }

            if (!string.IsNullOrWhiteSpace(filtroStatus) && Enum.TryParse<StatusMensalidade>(filtroStatus, out var status))
            {
                res = res.Where(m => m.Status == status);
            }

            if (!string.IsNullOrWhiteSpace(filtroCompetencia))
            {
                res = res.Where(m => m.Competencia.Contains(filtroCompetencia.Trim()));
            }

            return res;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosAsync();
    }

    private async Task CarregarDadosAsync()
    {
        carregando = true;
        try
        {
            var clubeId = Session.CurrentClubeId;
            mensalidades = await MensalidadeService.ListarMensalidadesAsync(clubeId);
            resumo = await MensalidadeService.ObterResumoFinanceiroAsync(clubeId);
        }
        catch (Exception ex)
        {
            mensagemAlerta = $"Erro ao carregar dados financeiros: {ex.Message}";
            isSucesso = false;
        }
        finally
        {
            carregando = false;
        }
    }

    private void AbrirModalLote()
    {
        loteRequest = new GerarLoteMensalidadesRequest
        {
            Competencia = $"{DateTime.Today.Month:D2}/{DateTime.Today.Year}",
            DataVencimento = DateTime.Today.AddDays(10)
        };
        exibirModalLote = true;
    }

    private async Task ConfirmarGeracaoLoteAsync()
    {
        try
        {
            var gerados = await MensalidadeService.GerarLoteMensalidadesAsync(loteRequest);
            exibirModalLote = false;
            mensagemAlerta = $"Sucesso! Foram emitidas {gerados} novas mensalidades para a competência {loteRequest.Competencia}.";
            isSucesso = true;
            await CarregarDadosAsync();
        }
        catch (Exception ex)
        {
            mensagemAlerta = $"Falha ao gerar lote: {ex.Message}";
            isSucesso = false;
        }
    }

    private void AbrirModalPix(MensalidadeDto m)
    {
        mensalidadeSelecionada = m;
        exibirModalPix = true;
    }

    private void AbrirModalBaixa(MensalidadeDto m)
    {
        mensalidadeSelecionada = m;
        baixaRequest = new BaixarMensalidadeRequest
        {
            DataPagamento = DateTime.Now,
            Comprovante = $"Baixa Manual Tesouraria - {DateTime.Now:dd/MM/yyyy HH:mm}"
        };
        exibirModalBaixa = true;
    }

    private async Task ConfirmarBaixaAsync()
    {
        if (mensalidadeSelecionada == null) return;

        try
        {
            var ok = await MensalidadeService.BaixarMensalidadeAsync(mensalidadeSelecionada.Id, baixaRequest);
            exibirModalBaixa = false;
            if (ok)
            {
                mensagemAlerta = $"Mensalidade de {mensalidadeSelecionada.NomeAssociado} ({mensalidadeSelecionada.Competencia}) baixada com sucesso!";
                isSucesso = true;
                await CarregarDadosAsync();
            }
            else
            {
                mensagemAlerta = "Não foi possível liquidar a mensalidade selecionada.";
                isSucesso = false;
            }
        }
        catch (Exception ex)
        {
            mensagemAlerta = $"Erro ao liquidar mensalidade: {ex.Message}";
            isSucesso = false;
        }
    }
}
