@page "/presidente/associados"
@rendermode InteractiveServer
@inject IAssociadoService AssociadoService
@inject WebAdminSession Session

<PageTitle>Aprovação e Gestão de Sócios - Presidente</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-person-check text-primary me-2"></i> Gestão & Aprovação de Sócios</h2>
        <p class="text-muted mb-0">Avalie os pedidos de adesão, defina a categoria do associado e consulte dependentes.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(MensagemSucesso))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i> @MensagemSucesso
        <button type="button" class="btn-close" @onclick="() => MensagemSucesso = null"></button>
    </div>
}

<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <button class="nav-link @(AbaAtiva == "pendentes" ? "active fw-bold" : "text-dark bg-white border")" @onclick='() => MudarAba("pendentes")'>
            <i class="bi bi-clock-history me-1 text-warning"></i> Aguardando Aprovação
            <span class="badge bg-warning text-dark ms-1">@TotalPendentes</span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(AbaAtiva == "ativos" ? "active fw-bold" : "text-dark bg-white border")" @onclick='() => MudarAba("ativos")'>
            <i class="bi bi-person-badge me-1 text-success"></i> Sócios Ativos (Fundadores & Convidados)
            <span class="badge bg-success ms-1">@TotalAtivos</span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(AbaAtiva == "simpatizantes" ? "active fw-bold" : "text-dark bg-white border")" @onclick='() => MudarAba("simpatizantes")'>
            <i class="bi bi-heart me-1 text-danger"></i> Simpatizantes
            <span class="badge bg-danger ms-1">@TotalSimpatizantes</span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(AbaAtiva == "rejeitados" ? "active fw-bold" : "text-dark bg-white border")" @onclick='() => MudarAba("rejeitados")'>
            <i class="bi bi-x-circle me-1 text-secondary"></i> Rejeitados
        </button>
    </li>
</ul>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nome / CPF</th>
                        <th>Categoria / Voto</th>
                        <th>Contato</th>
                        <th>Localização</th>
                        <th>Áreas de Interesse</th>
                        <th>Dependentes</th>
                        <th>Status</th>
                        <th class="text-end">Ações da Diretoria</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ListaFiltrada != null && ListaFiltrada.Count > 0)
                    {
                        @foreach (var a in ListaFiltrada)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@a.Nome</div>
                                    <small class="text-muted"><i class="bi bi-credit-card me-1"></i> CPF: @a.CPF</small>
                                    @if (a.DataNascimento.HasValue)
                                    {
                                        <div class="text-muted small">Nasc: @a.DataNascimento.Value.ToString("dd/MM/yyyy") (@a.Sexo, @a.EstadoCivil)</div>
                                    }
                                </td>
                                <td>
                                    @if (a.TipoAssociado == TipoAssociado.SocioFundadorComVoto)
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-check-circle-fill me-1"></i> Sócio Fundador (Tem Voto)</span>
                                    }
                                    else if (a.TipoAssociado == TipoAssociado.SocioConvidadoSemVoto)
                                    {
                                        <span class="badge bg-info text-dark"><i class="bi bi-clock me-1"></i> Sócio Convidado (Sem Voto)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-heart me-1"></i> Simpatizante</span>
                                    }
                                </td>
                                <td>
                                    <div><i class="bi bi-telephone text-muted me-1"></i> @a.Telefone</div>
                                    <small class="text-muted"><i class="bi bi-envelope text-muted me-1"></i> @a.Email</small>
                                </td>
                                <td>
                                    <div>@a.Endereco, @a.Bairro</div>
                                    <small class="text-muted">@a.Cidade - @a.UF</small>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(a.Interesses))
                                    {
                                        @foreach (var tag in a.Interesses.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="badge bg-light text-dark border me-1 mb-1">@tag.Trim()</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Nenhum</span>
                                    }
                                </td>
                                <td>
                                    @if (a.Dependentes != null && a.Dependentes.Count > 0)
                                    {
                                        <span class="badge bg-light text-primary border" title="@string.Join(", ", a.Dependentes.Select(d => $"{d.Nome} ({d.GrauParentesco})"))">
                                            <i class="bi bi-people-fill me-1"></i> @a.Dependentes.Count dependente(s)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Nenhum</span>
                                    }
                                </td>
                                <td>
                                    @if (a.StatusAprovacao == StatusAprovacao.Pendente)
                                    {
                                        <span class="badge bg-warning text-dark">Em Análise</span>
                                    }
                                    else if (a.StatusAprovacao == StatusAprovacao.Aprovado)
                                    {
                                        <span class="badge bg-success">Aprovado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger" title="@a.MotivoRejeicao">Rejeitado</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (a.StatusAprovacao == StatusAprovacao.Pendente)
                                    {
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-success" title="Aprovar como Convidado" @onclick="() => Aprovar(a.Id, TipoAssociado.SocioConvidadoSemVoto)">
                                                <i class="bi bi-check-lg"></i> Convidado
                                            </button>
                                            <button class="btn btn-outline-primary" title="Aprovar como Fundador (com direito a voto)" @onclick="() => Aprovar(a.Id, TipoAssociado.SocioFundadorComVoto)">
                                                <i class="bi bi-award"></i> Fundador
                                            </button>
                                            <button class="btn btn-outline-secondary" title="Aprovar como Simpatizante" @onclick="() => Aprovar(a.Id, TipoAssociado.Simpatizante)">
                                                <i class="bi bi-heart"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" title="Rejeitar Solicitação" @onclick="() => Rejeitar(a.Id)">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    }
                                    else if (a.StatusAprovacao == StatusAprovacao.Aprovado && a.TipoAssociado == TipoAssociado.SocioConvidadoSemVoto)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => Aprovar(a.Id, TipoAssociado.SocioFundadorComVoto)">
                                            <i class="bi bi-arrow-up-circle me-1"></i> Promover a Fundador (com Voto)
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Homologado</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                                Nenhum registro encontrado nesta categoria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<AssociadoDto>? TodosAssociados;
    private string AbaAtiva = "pendentes";
    private string? MensagemSucesso;

    private int TotalPendentes => TodosAssociados?.Count(a => a.StatusAprovacao == StatusAprovacao.Pendente) ?? 0;
    private int TotalAtivos => TodosAssociados?.Count(a => a.StatusAprovacao == StatusAprovacao.Aprovado && a.TipoAssociado != TipoAssociado.Simpatizante) ?? 0;
    private int TotalSimpatizantes => TodosAssociados?.Count(a => a.StatusAprovacao == StatusAprovacao.Aprovado && a.TipoAssociado == TipoAssociado.Simpatizante) ?? 0;

    private List<AssociadoDto> ListaFiltrada => AbaAtiva switch
    {
        "pendentes" => TodosAssociados?.Where(a => a.StatusAprovacao == StatusAprovacao.Pendente).ToList() ?? new(),
        "ativos" => TodosAssociados?.Where(a => a.StatusAprovacao == StatusAprovacao.Aprovado && a.TipoAssociado != TipoAssociado.Simpatizante).ToList() ?? new(),
        "simpatizantes" => TodosAssociados?.Where(a => a.StatusAprovacao == StatusAprovacao.Aprovado && a.TipoAssociado == TipoAssociado.Simpatizante).ToList() ?? new(),
        "rejeitados" => TodosAssociados?.Where(a => a.StatusAprovacao == StatusAprovacao.Rejeitado).ToList() ?? new(),
        _ => TodosAssociados ?? new()
    };

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosAsync();
    }

    private async Task CarregarDadosAsync()
    {
        TodosAssociados = await AssociadoService.ListarAssociadosAsync();
    }

    private void MudarAba(string aba) => AbaAtiva = aba;

    private async Task Aprovar(Guid id, TipoAssociado tipo)
    {
        await AssociadoService.AprovarAssociadoAsync(id, tipo);
        MensagemSucesso = $"Solicitação homologada com sucesso na categoria {tipo}!";
        await CarregarDadosAsync();
    }

    private async Task Rejeitar(Guid id)
    {
        await AssociadoService.RejeitarAssociadoAsync(id, "Não atende aos critérios estatutários da associação.");
        MensagemSucesso = "Solicitação rejeitada pela diretoria.";
        await CarregarDadosAsync();
    }
}
