@page "/"
@rendermode InteractiveServer
@inject WebAdminSession Session
@inject IClubeService ClubeService
@inject IAssociadoService AssociadoService
@inject IReservaService ReservaService
@inject IMensalidadeService MensalidadeService

<PageTitle>Painel de Controle - Projeto Clubes</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-speedometer2 text-primary me-2"></i> Painel de Controle
        </h2>
        <p class="text-muted mb-0">Visão consolidada da federação de clubes, associados e atividades.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-primary text-white">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-white-50 text-uppercase small fw-bold">Clubes Cadastrados</div>
                        <h2 class="fw-bold mb-0 mt-2">@TotalClubes</h2>
                    </div>
                    <i class="bi bi-buildings fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-success text-white">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-white-50 text-uppercase small fw-bold">Sócios Ativos</div>
                        <h2 class="fw-bold mb-0 mt-2">@TotalSociosAtivos</h2>
                    </div>
                    <i class="bi bi-people fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-warning text-dark">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-dark-50 text-uppercase small fw-bold">Aguardando Aprovação</div>
                        <h2 class="fw-bold mb-0 mt-2">@TotalSociosPendentes</h2>
                    </div>
                    <i class="bi bi-person-exclamation fs-1 text-dark-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-info text-white">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-white-50 text-uppercase small fw-bold">Reservas Ativas</div>
                        <h2 class="fw-bold mb-0 mt-2">@TotalReservas</h2>
                    </div>
                    <i class="bi bi-calendar-check fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-building me-2 text-primary"></i> Clubes da Federação</h5>
                @if (Session.Perfil == PerfilUsuario.SuperAdmin)
                {
                    <a href="superadmin/novo-clube" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-circle me-1"></i> Adicionar Clube
                    </a>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Clube / Sigla</th>
                                <th>Cidade / UF</th>
                                <th>Telefone / E-mail</th>
                                <th>Associados</th>
                                <th>Pendentes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Clubes != null && Clubes.Count > 0)
                            {
                                @foreach (var c in Clubes)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@c.Nome</div>
                                            <span class="badge bg-light text-dark border">@c.Sigla</span>
                                        </td>
                                        <td>@c.Cidade - @c.UF</td>
                                        <td>
                                            <div><i class="bi bi-telephone text-muted me-1"></i> @c.Telefone</div>
                                            <small class="text-muted"><i class="bi bi-envelope text-muted me-1"></i> @c.Email</small>
                                        </td>
                                        <td><span class="badge bg-success">@c.TotalAssociados sócios</span></td>
                                        <td>
                                            @if (c.AssociadosPendentes > 0)
                                            {
                                                <span class="badge bg-warning text-dark">@c.AssociadosPendentes pendente(s)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Nenhum</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Carregando clubes...</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0"><i class="bi bi-lightning-charge me-2 text-warning"></i> Ações Rápidas</h5>
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <a href="presidente/associados" class="btn btn-outline-primary d-flex align-items-center justify-content-between p-3 text-start rounded-3">
                    <div>
                        <div class="fw-bold">Aprovar Sócios</div>
                        <small class="text-muted">Analisar inscrições pendentes</small>
                    </div>
                    <i class="bi bi-arrow-right-circle fs-4"></i>
                </a>

                <a href="presidente/reservas" class="btn btn-outline-info d-flex align-items-center justify-content-between p-3 text-start rounded-3">
                    <div>
                        <div class="fw-bold">Salão Social & Agenda</div>
                        <small class="text-muted">Verificar bloqueio contínuo de horários</small>
                    </div>
                    <i class="bi bi-arrow-right-circle fs-4"></i>
                </a>

                <a href="tesoureiro/mensalidades" class="btn btn-outline-success d-flex align-items-center justify-content-between p-3 text-start rounded-3">
                    <div>
                        <div class="fw-bold">Gestão Financeira & PIX</div>
                        <small class="text-muted">Gerar lote e conciliar pagamentos</small>
                    </div>
                    <i class="bi bi-arrow-right-circle fs-4"></i>
                </a>

                <a href="presidente/eventos" class="btn btn-outline-secondary d-flex align-items-center justify-content-between p-3 text-start rounded-3">
                    <div>
                        <div class="fw-bold">Publicar Eventos</div>
                        <small class="text-muted">Almoços, jantares e feijoadas beneficentes</small>
                    </div>
                    <i class="bi bi-arrow-right-circle fs-4"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ClubeDto>? Clubes;
    private int TotalClubes = 0;
    private int TotalSociosAtivos = 0;
    private int TotalSociosPendentes = 0;
    private int TotalReservas = 0;

    protected override async Task OnInitializedAsync()
    {
        Clubes = await ClubeService.ListarTodosAsync();
        TotalClubes = Clubes.Count;

        var associados = await AssociadoService.ListarAssociadosAsync();
        TotalSociosAtivos = associados.Count(a => a.StatusAprovacao == StatusAprovacao.Aprovado);
        TotalSociosPendentes = associados.Count(a => a.StatusAprovacao == StatusAprovacao.Pendente);

        var reservas = await ReservaService.ObterReservasPorClubeAsync();
        TotalReservas = reservas.Count;
    }
}
