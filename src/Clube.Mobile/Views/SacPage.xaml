<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Clube.Mobile.ViewModels"
             xmlns:models="clr-namespace:Clube.Mobile.Models"
             x:Class="Clube.Mobile.Views.SacPage"
             x:DataType="vm:SacViewModel"
             Title="SAC"
             BackgroundColor="#0f172a">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            
            <Label Text="Atendimento &amp; Ouvidoria" FontSize="20" FontAttributes="Bold" TextColor="White" />
            <Label Text="Envie suas dúvidas, solicitações ou reclamações diretamente à diretoria do clube." TextColor="#94a3b8" FontSize="13" />

            <Label Text="{Binding StatusMessage}" TextColor="#38bdf8" FontSize="13" />

            <!-- Formulário -->
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="#1e293b" Stroke="#334155" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nova Mensagem" TextColor="White" FontSize="16" FontAttributes="Bold" />

                    <Label Text="Assunto da Manifestação" TextColor="#cbd5e1" FontSize="12" FontAttributes="Bold" />
                    <Entry Text="{Binding Assunto}" Placeholder="ex: Manutenção da piscina, sugestão para torneio..." TextColor="White" PlaceholderColor="#64748b" BackgroundColor="#0f172a" />

                    <Label Text="Mensagem Detalhada" TextColor="#cbd5e1" FontSize="12" FontAttributes="Bold" />
                    <Editor Text="{Binding Mensagem}" Placeholder="Descreva sua solicitação com detalhes..." TextColor="White" PlaceholderColor="#64748b" BackgroundColor="#0f172a" HeightRequest="100" />

                    <Button Text="Enviar Manifestação"
                            Command="{Binding EnviarSolicitacaoCommand}"
                            BackgroundColor="#2563eb"
                            TextColor="White"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            HeightRequest="44"
                            Margin="0,6,0,0" />

                </VerticalStackLayout>
            </Border>

            <!-- Histórico -->
            <Label Text="Minhas Manifestações Anteriores" TextColor="White" FontSize="16" FontAttributes="Bold" Margin="0,8,0,0" />

            <CollectionView ItemsSource="{Binding Solicitacoes}">
                <CollectionView.EmptyView>
                    <Label Text="Você ainda não enviou solicitações ou reclamações." TextColor="#64748b" FontSize="13" Padding="20" HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LocalSolicitacao">
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="#1e293b" Stroke="#334155" Padding="14" Margin="0,0,0,8">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Assunto}" TextColor="White" FontAttributes="Bold" FontSize="15" />
                                    <Border Grid.Column="1" StrokeShape="RoundRectangle 4" BackgroundColor="#334155" Padding="6,2">
                                        <Label Text="{Binding Status}" TextColor="#38bdf8" FontSize="11" FontAttributes="Bold" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Mensagem}" TextColor="#94a3b8" FontSize="13" />

                                <Label Text="{Binding DataAbertura, StringFormat='Enviado em: {0:dd/MM/yyyy HH:mm}'}" TextColor="#64748b" FontSize="11" />

                                <!-- Resposta da Diretoria -->
                                <Border StrokeShape="RoundRectangle 6" BackgroundColor="#0f172a" Stroke="#334155" Padding="10" Margin="0,4,0,0">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Resposta da Diretoria:" TextColor="#10b981" FontSize="11" FontAttributes="Bold" />
                                        <Label Text="{Binding Resposta, FallbackValue='Aguardando análise da diretoria'}" TextColor="#cbd5e1" FontSize="12" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
