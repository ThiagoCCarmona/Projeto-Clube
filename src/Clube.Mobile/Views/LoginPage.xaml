<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Clube.Mobile.ViewModels"
             x:Class="Clube.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0f172a">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
            
            <!-- Logo / Brand Header -->
            <Border StrokeShape="RoundRectangle 24"
                    BackgroundColor="#1e293b"
                    Padding="20"
                    Stroke="#334155"
                    StrokeThickness="1"
                    HorizontalOptions="Center"
                    WidthRequest="80"
                    HeightRequest="80">
                <Label Text="🏛️" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="Projeto Clubes"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />
                <Label Text="Aplicativo Móvel com Modo Offline-First"
                       FontSize="13"
                       TextColor="#94a3b8"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Card de Login -->
            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="#1e293b"
                    Padding="24"
                    Stroke="#334155"
                    StrokeThickness="1"
                    Margin="0,10,0,0">
                
                <VerticalStackLayout Spacing="16">
                    
                    <Label Text="Acesse sua Conta"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <!-- Status Message / Alert -->
                    <Label Text="{Binding StatusMessage}" 
                           TextColor="#38bdf8" 
                           FontSize="13" 
                           HorizontalTextAlignment="Center" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="CPF do Associado" TextColor="#cbd5e1" FontSize="13" FontAttributes="Bold" />
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="#0f172a" Stroke="#475569" Padding="12,4">
                            <Entry Text="{Binding CPF}" 
                                   Placeholder="ex: 111.111.111-11" 
                                   TextColor="White" 
                                   PlaceholderColor="#64748b" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Senha" TextColor="#cbd5e1" FontSize="13" FontAttributes="Bold" />
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="#0f172a" Stroke="#475569" Padding="12,4">
                            <Entry Text="{Binding Senha}" 
                                   IsPassword="True" 
                                   Placeholder="••••••••" 
                                   TextColor="White" 
                                   PlaceholderColor="#64748b" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Entrar no Aplicativo"
                            Command="{Binding LoginCommand}"
                            BackgroundColor="#2563eb"
                            TextColor="White"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            Margin="0,10,0,0" />

                    <Button Text="Preencher Sócio Demo"
                            Command="{Binding UsarCredenciaisDemoCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#38bdf8"
                            FontSize="12" />

                </VerticalStackLayout>
            </Border>

            <!-- Ações Secundárias -->
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                <Label Text="Ainda não é associado ao clube?"
                       TextColor="#94a3b8"
                       FontSize="13"
                       HorizontalTextAlignment="Center" />
                
                <Button Text="Filie-se como Convidado ou Simpatizante"
                        Command="{Binding IrParaCadastroCommand}"
                        BackgroundColor="#334155"
                        TextColor="White"
                        CornerRadius="8"
                        FontSize="13"
                        HeightRequest="42" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}" 
                               Color="#38bdf8" 
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
